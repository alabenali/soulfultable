# Email configuration (example using ethereal.email or real SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_FROM="Soulful Table" <no-reply@soulftable.com>

# Admin password hash for the back office (required)
# Generate one with: npm run hash-password
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# Session secret for express-session (required) - use a long random string
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# RIB shown on the confirmation page (public)
RIB=

# Database: leave DB_CLIENT unset for SQLite, or configure MySQL/MariaDB (XAMPP)
DB_CLIENT=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=soulful_table

# Port for server (optional)
PORT=5000